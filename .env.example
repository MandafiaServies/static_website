# Copy to .env for local testing. On GoDaddy, set these as environment variables
# in the app settings instead. Never commit a real .env file.

# --- Email delivery -------------------------------------------------------
# resend = HTTPS API (use this on GoDaddy Node.js hosting, outbound SMTP is blocked)
# smtp   = any SMTP server (local testing, VPS)
MAIL_TRANSPORT=resend

# Where enquiries are delivered (must be a real mailbox)
TO_EMAIL=customersupport@mandafiaservices.com
# Sender address. With Resend it must be on a domain you verified there.
FROM_EMAIL=customersupport@mandafiaservices.com
FROM_NAME=Mandafia Services Website

# Resend (MAIL_TRANSPORT=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (MAIL_TRANSPORT=smtp)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=customersupport@mandafiaservices.com
SMTP_PASS=GAXz@j@KrNqgp8X

# --- Spam protection ------------------------------------------------------
RATE_LIMIT_PER_HOUR=5